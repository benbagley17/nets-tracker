<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Brooklyn Nets · Milestone & Streak Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=Barlow:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --black:#000;
  --white:#fff;
  --gray-950:#0a0a0a;
  --gray-900:#111;
  --gray-800:#1a1a1a;
  --gray-700:#252525;
  --gray-600:#333;
  --gray-500:#555;
  --gray-400:#888;
  --gray-300:#aaa;
  --gray-200:#ccc;
  --gray-100:#e8e8e8;
  --accent:#c8a96e;
  --accent-dim:rgba(200,169,110,.12);
  --red:#e05252;
  --red-dim:rgba(224,82,82,.12);
  --green:#52c875;
  --green-dim:rgba(82,200,117,.1);
  --blue:#5299e0;
  --blue-dim:rgba(82,153,224,.1);
  --text:#f0f0f0;
  --text-muted:#888;
  --text-dim:#555;
  --border:rgba(255,255,255,.08);
  --border-mid:rgba(255,255,255,.14);
}
html,body{background:var(--black);color:var(--text);font-family:'Barlow',sans-serif;min-height:100vh;font-size:14px;line-height:1.5}

/* LAYOUT */
.app{display:grid;grid-template-rows:auto 1fr;min-height:100vh}
.topbar{background:var(--gray-900);border-bottom:1px solid var(--border);padding:0 24px;display:flex;align-items:center;justify-content:space-between;height:52px;position:sticky;top:0;z-index:100}
.topbar-left{display:flex;align-items:center;gap:14px}
.logo-mark{width:32px;height:32px;background:var(--white);border-radius:3px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.logo-mark svg{width:22px;height:22px}
.topbar-title{font-family:'Barlow Condensed',sans-serif;font-size:17px;font-weight:800;letter-spacing:.4px;color:var(--white)}
.topbar-sub{font-size:11px;color:var(--text-dim);letter-spacing:.8px;text-transform:uppercase;margin-top:1px}
.topbar-right{display:flex;align-items:center;gap:10px}
.last-updated{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--text-dim)}
.live-dot{width:7px;height:7px;border-radius:50%;background:var(--red);animation:pulse 2s infinite;flex-shrink:0}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.85)}}
.refresh-btn{background:var(--gray-800);border:1px solid var(--gray-600);color:var(--text-muted);padding:5px 10px;border-radius:4px;cursor:pointer;font-size:11px;font-family:'Barlow',sans-serif;letter-spacing:.5px;transition:all .2s}
.refresh-btn:hover{background:var(--gray-700);color:var(--text)}
.refresh-btn.spinning svg{animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* MAIN LAYOUT */
.main{display:grid;grid-template-columns:200px 1fr;height:calc(100vh - 52px);overflow:hidden}

/* SIDEBAR */
.sidebar{background:var(--gray-900);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow-y:auto;padding:16px 0}
.sidebar-section{padding:0 12px;margin-bottom:8px}
.sidebar-label{font-size:10px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-dim);padding:0 4px;margin-bottom:6px}
.sidebar-btn{width:100%;text-align:left;padding:7px 10px;background:transparent;border:none;border-radius:4px;color:var(--text-muted);font-family:'Barlow',sans-serif;font-size:13px;font-weight:500;cursor:pointer;transition:all .15s;display:flex;align-items:center;gap:8px;position:relative}
.sidebar-btn:hover{background:var(--gray-800);color:var(--text)}
.sidebar-btn.active{background:rgba(200,169,110,.1);color:var(--accent)}
.sidebar-btn .count{margin-left:auto;font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--text-dim);background:var(--gray-800);padding:1px 6px;border-radius:3px;min-width:22px;text-align:center}
.sidebar-btn.active .count{background:rgba(200,169,110,.15);color:var(--accent)}
.sidebar-divider{height:1px;background:var(--border);margin:10px 12px}
.config-area{padding:12px;margin-top:auto}
.slack-form{background:var(--gray-800);border:1px solid var(--border);border-radius:6px;padding:12px}
.slack-form-title{font-size:11px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:var(--text-dim);margin-bottom:8px;display:flex;align-items:center;gap:6px}
.slack-icon{width:14px;height:14px;fill:currentColor}
.slack-input{width:100%;background:var(--gray-700);border:1px solid var(--gray-600);border-radius:4px;padding:6px 8px;color:var(--text);font-size:11px;font-family:'IBM Plex Mono',monospace;outline:none;transition:border .15s}
.slack-input:focus{border-color:var(--accent)}
.slack-input::placeholder{color:var(--text-dim)}
.slack-save{width:100%;margin-top:8px;background:var(--accent);border:none;border-radius:4px;padding:6px;color:var(--black);font-weight:600;font-size:12px;cursor:pointer;font-family:'Barlow',sans-serif;letter-spacing:.5px;transition:opacity .2s}
.slack-save:hover{opacity:.85}
.slack-status{font-size:10px;color:var(--text-dim);margin-top:6px;text-align:center;min-height:14px}
.slack-status.ok{color:var(--green)}
.slack-status.err{color:var(--red)}
.threshold-row{display:flex;align-items:center;gap:6px;margin-top:8px}
.threshold-row label{font-size:11px;color:var(--text-muted);flex:1}
.threshold-input{width:44px;background:var(--gray-700);border:1px solid var(--gray-600);border-radius:3px;padding:4px 6px;color:var(--text);font-size:12px;font-family:'IBM Plex Mono',monospace;text-align:center;outline:none}

/* CONTENT */
.content{overflow-y:auto;padding:20px 24px}

/* SUMMARY STRIP */
.summary-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:20px}
.summary-card{background:var(--gray-900);border:1px solid var(--border);border-radius:6px;padding:12px 14px}
.summary-num{font-family:'Barlow Condensed',sans-serif;font-size:30px;font-weight:800;line-height:1}
.summary-lbl{font-size:10px;color:var(--text-dim);letter-spacing:.6px;margin-top:2px;text-transform:uppercase}
.num-red{color:var(--red)}
.num-amber{color:var(--accent)}
.num-green{color:var(--green)}
.num-blue{color:var(--blue)}

/* SEARCH & FILTER */
.toolbar{display:flex;gap:8px;margin-bottom:16px;align-items:center}
.search-wrap{flex:1;position:relative}
.search-icon{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--text-dim);width:14px;height:14px}
.search-input{width:100%;background:var(--gray-900);border:1px solid var(--border);border-radius:5px;padding:8px 12px 8px 30px;color:var(--text);font-family:'Barlow',sans-serif;font-size:13px;outline:none;transition:border .15s}
.search-input:focus{border-color:var(--gray-500)}
.search-input::placeholder{color:var(--text-dim)}
.filter-btns{display:flex;gap:4px;flex-wrap:wrap}
.flt{padding:5px 10px;background:transparent;border:1px solid var(--border);border-radius:4px;color:var(--text-muted);font-size:11px;font-weight:500;cursor:pointer;font-family:'Barlow',sans-serif;transition:all .15s;white-space:nowrap}
.flt:hover{border-color:var(--gray-500);color:var(--text)}
.flt.active{border-color:var(--accent);color:var(--accent);background:var(--accent-dim)}

/* SECTION */
.section-header{font-family:'Barlow Condensed',sans-serif;font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--text-dim);padding:8px 0 8px;border-bottom:1px solid var(--border);margin-bottom:8px;display:flex;align-items:center;gap:8px}
.section-header::after{content:'';flex:1;height:1px;background:var(--border)}
.section-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.dot-red{background:var(--red)}
.dot-amber{background:var(--accent)}
.dot-green{background:var(--green)}
.dot-blue{background:var(--blue)}
.section-block{margin-bottom:20px}

/* MILESTONE CARD */
.mcard{background:var(--gray-900);border:1px solid var(--border);border-radius:6px;overflow:hidden;cursor:pointer;transition:border-color .15s}
.mcard:hover{border-color:var(--gray-500)}
.mcard+.mcard{margin-top:6px}
.mcard.urgency-urgent{border-left:2px solid var(--red)}
.mcard.urgency-close{border-left:2px solid var(--accent)}
.mcard.urgency-streak{border-left:2px solid var(--green)}
.mcard.urgency-upcoming{border-left:2px solid var(--blue)}
.card-main{padding:12px 14px}
.card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:10px}
.card-player-info{display:flex;flex-direction:column;gap:1px}
.card-player{font-family:'Barlow Condensed',sans-serif;font-size:17px;font-weight:700;color:var(--white);line-height:1.1}
.card-num{font-size:12px;color:var(--text-dim);font-weight:400}
.card-stat{font-size:11px;color:var(--text-muted);margin-top:2px}
.card-badges{display:flex;gap:4px;align-items:center;flex-wrap:wrap;justify-content:flex-end;flex-shrink:0}
.badge{font-size:9px;font-weight:700;padding:3px 7px;border-radius:3px;letter-spacing:.7px;text-transform:uppercase;white-space:nowrap}
.badge-red{background:var(--red-dim);color:var(--red);border:1px solid rgba(224,82,82,.25)}
.badge-amber{background:var(--accent-dim);color:var(--accent);border:1px solid rgba(200,169,110,.25)}
.badge-green{background:var(--green-dim);color:var(--green);border:1px solid rgba(82,200,117,.2)}
.badge-blue{background:var(--blue-dim);color:var(--blue);border:1px solid rgba(82,153,224,.2)}
.badge-gray{background:rgba(136,136,136,.1);color:var(--text-muted);border:1px solid rgba(136,136,136,.15)}
.badge-type{font-family:'IBM Plex Mono',monospace}

/* PROGRESS */
.progress-row{display:flex;align-items:center;gap:10px}
.progress-track{flex:1;height:4px;background:var(--gray-700);border-radius:2px;overflow:hidden}
.progress-fill{height:100%;border-radius:2px;transition:width .5s ease}
.fill-red{background:var(--red)}
.fill-amber{background:var(--accent)}
.fill-green{background:var(--green)}
.fill-blue{background:var(--blue)}
.progress-label{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--text-muted);white-space:nowrap;flex-shrink:0}
.progress-label strong{color:var(--text);font-weight:500}
.card-snippet{font-size:12px;color:var(--text-muted);margin-top:8px;line-height:1.55}
.expand-hint{font-size:10px;color:var(--text-dim);margin-top:6px;letter-spacing:.3px}

/* EXPANDED */
.card-expanded{border-top:1px solid var(--border);padding:12px 14px;display:none;animation:fadeIn .15s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}
.card-expanded.open{display:block}
.alert-block{background:rgba(200,169,110,.07);border:1px solid rgba(200,169,110,.2);border-radius:4px;padding:10px 12px;margin-bottom:12px}
.alert-block-title{font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--accent);margin-bottom:4px}
.alert-block-text{font-size:12px;color:#c8b882;line-height:1.6}
.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border)}
.detail-cell{background:var(--gray-900);padding:7px 10px}
.detail-lbl{font-size:10px;color:var(--text-dim);letter-spacing:.4px;margin-bottom:2px;text-transform:uppercase}
.detail-val{font-size:12px;color:var(--text);font-weight:500}
.card-footer{margin-top:10px;display:flex;align-items:center;justify-content:space-between}
.test-alert-btn{background:transparent;border:1px solid var(--gray-600);border-radius:3px;padding:4px 10px;color:var(--text-muted);font-size:11px;cursor:pointer;font-family:'Barlow',sans-serif;transition:all .2s}
.test-alert-btn:hover{border-color:var(--accent);color:var(--accent)}
.test-alert-btn.sent{border-color:var(--green);color:var(--green)}
.collapse-hint{font-size:10px;color:var(--text-dim)}

/* ERROR & LOADING */
.loading-state,.error-state,.empty-state{padding:40px;text-align:center;color:var(--text-dim);font-size:14px}
.loading-spinner{width:24px;height:24px;border:2px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}
.error-text{color:var(--red);font-size:13px;margin-bottom:8px}

/* API CONFIG BANNER */
.api-banner{background:rgba(200,169,110,.07);border:1px solid rgba(200,169,110,.2);border-radius:6px;padding:12px 16px;margin-bottom:16px;display:none}
.api-banner.show{display:flex;align-items:flex-start;gap:12px}
.api-banner-icon{font-size:18px;flex-shrink:0;margin-top:1px}
.api-banner-content{flex:1}
.api-banner-title{font-size:13px;font-weight:600;color:var(--accent);margin-bottom:3px}
.api-banner-text{font-size:12px;color:#c8b882;line-height:1.55}
.api-banner-text code{font-family:'IBM Plex Mono',monospace;background:rgba(200,169,110,.12);padding:1px 4px;border-radius:2px;font-size:11px}
.api-banner-close{background:transparent;border:none;color:var(--text-dim);cursor:pointer;font-size:16px;flex-shrink:0;padding:0}

/* DATA SOURCE BADGE */
.data-source{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--text-dim);display:flex;align-items:center;gap:5px}
.data-source.live::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--green);flex-shrink:0}
.data-source.demo::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--accent);flex-shrink:0}
</style>
</head>
<body>
<div class="app">

  <!-- TOPBAR -->
  <div class="topbar">
    <div class="topbar-left">
      <div class="logo-mark">
        <svg viewBox="0 0 100 100"><rect width="100" height="100" fill="#000"/><text x="50" y="68" text-anchor="middle" font-family="Arial Black,sans-serif" font-weight="900" font-size="52" fill="white">NJ</text></svg>
      </div>
      <div>
        <div class="topbar-title">Brooklyn Nets · Milestone & Streak Tracker</div>
        <div class="topbar-sub">Media Intelligence Dashboard</div>
      </div>
    </div>
    <div class="topbar-right">
      <span class="data-source demo" id="dataSourceBadge">demo mode</span>
      <span class="last-updated" id="lastUpdated">—</span>
      <div class="live-dot"></div>
      <button class="refresh-btn" onclick="refreshData()" title="Refresh data">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
        Refresh
      </button>
    </div>
  </div>

  <div class="main">

    <!-- SIDEBAR -->
    <div class="sidebar">
      <div class="sidebar-section">
        <div class="sidebar-label">View</div>
        <button class="sidebar-btn active" onclick="setView('all')" id="nav-all">
          All Alerts
          <span class="count" id="cnt-all">0</span>
        </button>
        <button class="sidebar-btn" onclick="setView('milestones')" id="nav-milestones">
          Milestones
          <span class="count" id="cnt-milestones">0</span>
        </button>
        <button class="sidebar-btn" onclick="setView('streaks')" id="nav-streaks">
          Streaks
          <span class="count" id="cnt-streaks">0</span>
        </button>
        <button class="sidebar-btn" onclick="setView('records')" id="nav-records">
          Record Watch
          <span class="count" id="cnt-records">0</span>
        </button>
      </div>

      <div class="sidebar-divider"></div>

      <div class="sidebar-section">
        <div class="sidebar-label">Players</div>
        <div id="playerFilters"></div>
      </div>

      <div class="sidebar-divider"></div>

      <div class="config-area">
        <div class="slack-form">
          <div class="slack-form-title">
            <svg class="slack-icon" viewBox="0 0 24 24"><path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zm1.271 0a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zm0 1.271a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zm10.122 2.521a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zm-1.268 0a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zm-2.523 10.122a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zm0-1.268a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z"/></svg>
            Slack Alerts
          </div>
          <input class="slack-input" id="slackWebhook" placeholder="Webhook URL" type="url">
          <div class="threshold-row">
            <label>Alert when ≤ games away</label>
            <input class="threshold-input" id="alertThreshold" type="number" value="5" min="1" max="20">
          </div>
          <button class="slack-save" onclick="saveSlackConfig()">Save Configuration</button>
          <div class="slack-status" id="slackStatus"></div>
        </div>

        <div style="margin-top:12px;padding:0 2px">
          <div class="sidebar-label" style="margin-bottom:6px">NBA API Key</div>
          <input class="slack-input" id="apiKeyInput" placeholder="Sportsradar API key" type="password" style="margin-bottom:6px">
          <button class="slack-save" onclick="saveApiKey()">Connect Live Data</button>
          <div class="slack-status" id="apiStatus"></div>
        </div>
      </div>
    </div>

    <!-- CONTENT -->
    <div class="content" id="content">

      <div class="api-banner" id="apiBanner">
        <div class="api-banner-icon">⚡</div>
        <div class="api-banner-content">
          <div class="api-banner-title">Connect Live NBA Data</div>
          <div class="api-banner-text">
            Add a <strong>Sportradar NBA API key</strong> in the sidebar to pull real-time stats automatically after each game. Without it, the dashboard runs on curated data from the 2025-26 season that you can update manually. Get a key at <code>developer.sportradar.com</code>.
          </div>
        </div>
        <button class="api-banner-close" onclick="document.getElementById('apiBanner').classList.remove('show')">✕</button>
      </div>

      <div class="summary-strip">
        <div class="summary-card">
          <div class="summary-num num-red" id="s-urgent">0</div>
          <div class="summary-lbl">Imminent (≤5 games)</div>
        </div>
        <div class="summary-card">
          <div class="summary-num num-amber" id="s-close">0</div>
          <div class="summary-lbl">Approaching (≤15)</div>
        </div>
        <div class="summary-card">
          <div class="summary-num num-green" id="s-streaks">0</div>
          <div class="summary-lbl">Active Streaks</div>
        </div>
        <div class="summary-card">
          <div class="summary-num num-blue" id="s-records">0</div>
          <div class="summary-lbl">Record Watch</div>
        </div>
      </div>

      <div class="toolbar">
        <div class="search-wrap">
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input class="search-input" id="searchInput" placeholder="Search player, stat, category..." oninput="render()">
        </div>
        <div class="filter-btns" id="catFilters"></div>
      </div>

      <div id="cardsArea"></div>
    </div>
  </div>
</div>

<script src="data.js"></script>
<script src="app.js"></script>
</body>
</html>
