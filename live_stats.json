async function refreshData() {
  const btn = document.querySelector('.refresh-btn');
  btn.classList.add('spinning');
  await loadData();
  setTimeout(() => btn.classList.remove('spinning'), 600);
}

function setDataMode(mode) {
  state.dataMode = mode;
  const badge = document.getElementById('dataSourceBadge');
  if (mode === 'live')    { badge.textContent = 'live · hoopR'; badge.className = 'data-source live'; }
  else if (mode === 'demo') { badge.textContent = 'demo data';  badge.className = 'data-source demo'; }
  else                    { badge.textContent = 'loading…';    badge.className = 'data-source'; }
}

function updateLastUpdated(meta) {
  const el = document.getElementById('lastUpdated');
  if (!meta?.generated_at && !state.lastUpdated) { el.textContent = 'demo mode'; return; }
  const d = state.lastUpdated || new Date(meta.generated_at);
  el.textContent = 'Updated ' + d.toLocaleTimeString('en-US', { hour:'numeric', minute:'2-digit' });
}

// ── CONFIG ────────────────────────────────────────────────────
function loadPersistedConfig() {
  try {
    const cfg = JSON.parse(localStorage.getItem('netsTrackerConfig') || '{}');
    if (cfg.slackWebhook)   { state.slackWebhook = cfg.slackWebhook; document.getElementById('slackWebhook').value = cfg.slackWebhook; }
    if (cfg.alertThreshold) { state.alertThreshold = cfg.alertThreshold; document.getElementById('alertThreshold').value = cfg.alertThreshold; }
    if (cfg.sentAlerts)     state.sentAlerts = new Set(cfg.sentAlerts);
  } catch(e) {}
}

function persistConfig() {
  try {
    localStorage.setItem('netsTrackerConfig', JSON.stringify({
      slackWebhook: state.slackWebhook,
      alertThreshold: state.alertThreshold,
      sentAlerts: [...state.sentAlerts],
    }));
  } catch(e) {}
}

function saveSlackConfig() {
  const webhook   = document.getElementById('slackWebhook').value.trim();
  const threshold = parseInt(document.getElementById('alertThreshold').value) || 5;
  const statusEl  = document.getElementById('slackStatus');
  if (!webhook.startsWith('https://hooks.slack.com/')) {
    statusEl.textContent = 'Invalid Slack webhook URL'; statusEl.className = 'slack-status err'; return;
  }
  state.slackWebhook = webhook; state.alertThreshold = threshold;
  persistConfig();
  statusEl.textContent = '✓ Saved — alerts active'; statusEl.className = 'slack-status ok';
  checkAndSendAlerts(false);
}

// ── SLACK ─────────────────────────────────────────────────────
async function checkAndSendAlerts(force = false) {
  if (!state.slackWebhook) return;
  const candidates = state.allItems.filter(m => m.urgency === 'urgent' && (force || !state.sentAlerts.has(m.id)));
  for (const item of candidates) {
    try { await sendSlackAlert(state.slackWebhook, item); state.sentAlerts.add(item.id); }
    catch(err) { console.error('Slack error:', err); }
  }
  persistConfig();
}

async function sendSlackAlert(webhook, item) {
  const emoji = { urgent:'🚨', close:'⚡', upcoming:'📅' };
  const gamesStr = item.gamesAway != null ? '~' + item.gamesAway : 'N/A';
  const payload = {
    text: (emoji[item.urgency]||'📊') + ' *Nets ' + item.type.charAt(0).toUpperCase()+item.type.slice(1) + ' Alert*',
    blocks: [
      { type:'header', text:{ type:'plain_text', text:(emoji[item.urgency]||'📊')+' '+item.playerName+' — '+item.statType, emoji:true }},
      { type:'section', fields:[
        { type:'mrkdwn', text:'*Progress:*\n'+(item.current||0).toLocaleString()+' / '+(item.target||0).toLocaleString()+' '+item.unit },
        { type:'mrkdwn', text:'*Games Away:*\n'+gamesStr },
        { type:'mrkdwn', text:'*Category:*\n'+item.category },
        { type:'mrkdwn', text:'*Type:*\n'+item.type.charAt(0).toUpperCase()+item.type.slice(1) },
      ]},
      { type:'section', text:{ type:'mrkdwn', text:'*📋 Media Note:*\n'+(item.mediaAlert||'') }},
      { type:'context', elements:[{ type:'mrkdwn', text:'Nets Milestone Tracker · '+new Date().toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'}) }]},
    ]
  };
  await fetch(webhook, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload), mode:'no-cors' });
}

async function testSlackAlert(itemId) {
  const item = state.allItems.find(m => m.id === itemId);
  if (!item || !state.slackWebhook) { alert('Set up your Slack webhook first.'); return; }
  const btn = document.querySelector('[data-test-id="'+itemId+'"]');
  if (btn) { btn.textContent = 'Sending…'; btn.disabled = true; }
  try {
    await sendSlackAlert(state.slackWebhook, item);
    if (btn) { btn.textContent = '✓ Sent!'; btn.className = 'test-alert-btn sent'; }
    setTimeout(() => { if (btn) { btn.textContent = 'Test Alert'; btn.className = 'test-alert-btn'; btn.disabled = false; } }, 3000);
  } catch(err) { if (btn) { btn.textContent = 'Error'; btn.disabled = false; } }
}

// ── NAVIGATION ────────────────────────────────────────────────
function setView(v) {
  state.view = v;
  document.querySelectorAll('.sidebar-btn[id^="nav-"]').forEach(b => b.classList.remove('active'));
  document.getElementById('nav-'+v)?.classList.add('active');
  render();
}

function setPlayerFilter(pid) {
  state.playerFilter = pid;
  document.querySelectorAll('.sidebar-btn[data-player]').forEach(b => b.classList.remove('active'));
  document.querySelector('[data-player="'+pid+'"]')?.classList.add('active');
  render();
}

function setCatFilter(cat, ev) {
  state.catFilter = cat;
  document.querySelectorAll('.flt').forEach(b => b.classList.remove('active'));
  if (ev?.currentTarget) ev.currentTarget.classList.add('active');
  render();
}

function toggleCard(id) {
  if (state.expandedCards.has(id)) state.expandedCards.delete(id);
  else state.expandedCards.add(id);
  render();
}

// ── SIDEBAR / FILTERS ─────────────────────────────────────────
function buildSidebar() {
  const pids = [...new Set(state.allItems.map(m => m.player))];
  document.getElementById('playerFilters').innerHTML = pids.map(pid => {
    const p = state.roster.find(r => r.id === pid);
    if (!p) return '';
    const n = state.allItems.filter(m => m.player === pid).length;
    return '<button class="sidebar-btn" data-player="'+pid+'" onclick="setPlayerFilter(\''+pid+'\')">'+p.name.split(' ').pop()+'<span class="count">'+n+'</span></button>';
  }).join('');
}

function buildCatFilters() {
  const cats = [...new Set(state.allItems.map(m => m.category))];
  document.getElementById('catFilters').innerHTML =
    '<button class="flt active" onclick="setCatFilter(\'all\', event)">All</button>'
    + cats.map(c => '<button class="flt" onclick="setCatFilter(\''+c+'\', event)">'+c+'</button>').join('');
}

// ── RENDER ────────────────────────────────────────────────────
const UO = { urgent:0, close:1, upcoming:2 };
const UL = { urgent:'Imminent — ≤5 Games', close:'Approaching — ≤15 Games', upcoming:'On the Horizon' };
const UD = { urgent:'dot-red', close:'dot-amber', upcoming:'dot-blue' };
const PF = { urgent:'fill-red', close:'fill-amber', upcoming:'fill-blue' };
const TB = { milestone:'badge-gray', streak:'badge-green', record:'badge-amber' };
const UB = { urgent:'badge-red', close:'badge-amber', upcoming:'badge-blue' };

function getFiltered() {
  const search = (document.getElementById('searchInput')?.value||'').toLowerCase();
  return state.allItems.filter(m => {
    if (state.view==='milestones' && m.type!=='milestone') return false;
    if (state.view==='streaks'    && m.type!=='streak')   return false;
    if (state.view==='records'    && m.type!=='record')   return false;
    if (state.playerFilter!=='all' && m.player!==state.playerFilter) return false;
    if (state.catFilter!=='all'    && m.category!==state.catFilter)  return false;
    if (search) { const h=[m.playerName,m.statType,m.category,m.mediaAlert].join(' ').toLowerCase(); if (!h.includes(search)) return false; }
    return true;
  }).sort((a,b)=>(UO[a.urgency]??3)-(UO[b.urgency]??3));
}

function render() {
  const all = state.allItems;
  document.getElementById('s-urgent').textContent  = all.filter(m=>m.urgency==='urgent').length;
  document.getElementById('s-close').textContent   = all.filter(m=>m.urgency==='close').length;
  document.getElementById('s-streaks').textContent = all.filter(m=>m.type==='streak').length;
  document.getElementById('s-records').textContent = all.filter(m=>m.type==='record').length;
  document.getElementById('cnt-all').textContent         = all.length;
  document.getElementById('cnt-milestones').textContent  = all.filter(m=>m.type==='milestone').length;
  document.getElementById('cnt-streaks').textContent     = all.filter(m=>m.type==='streak').length;
  document.getElementById('cnt-records').textContent     = all.filter(m=>m.type==='record').length;

  const filtered   = getFiltered();
  const container  = document.getElementById('cardsArea');

  if (state.dataMode==='loading') { container.innerHTML='<div class="loading-state"><div class="loading-spinner"></div>Loading stats from hoopR…</div>'; return; }
  if (!filtered.length)           { container.innerHTML='<div class="empty-state">No milestones match your current filters.</div>'; return; }

  const groups = {};
  filtered.forEach(m => { if (!groups[m.urgency]) groups[m.urgency]=[]; groups[m.urgency].push(m); });

  container.innerHTML = Object.keys(groups)
    .sort((a,b)=>(UO[a]??3)-(UO[b]??3))
    .map(urg => '<div class="section-block"><div class="section-header"><span class="section-dot '+(UD[urg]||'dot-blue')+'"></span>'+(UL[urg]||urg)+'</div>'+groups[urg].map(renderCard).join('')+'</div>')
    .join('');
}

function renderCard(m) {
  const pct = Math.min(100, Math.round(((m.current||0)/(m.target||1))*100));
  const isExpanded = state.expandedCards.has(m.id);
  const gamesLabel = m.gamesAway!=null ? '~'+m.gamesAway : (m.pace===0 ? 'Out for season' : '—');

  const streakExtras = m.type==='streak' ? [
    m.isActive   ? '<div class="detail-cell"><div class="detail-lbl">Current Streak</div><div class="detail-val">'+m.current+' games</div></div>' : '',
    m.seasonBest!=null ? '<div class="detail-cell"><div class="detail-lbl">Season Best</div><div class="detail-val">'+m.seasonBest+' games</div></div>' : '',
    m.franchiseRecord!=null ? '<div class="detail-cell"><div class="detail-lbl">Franchise Record</div><div class="detail-val">'+m.franchiseRecord+' games<br><span style="font-size:10px;color:var(--text-dim)">'+(m.franchiseHolder||'')+'</span></div></div>' : '',
    m.threshold!=null ? '<div class="detail-cell"><div class="detail-lbl">Threshold</div><div class="detail-val">'+m.threshold+'+ per game</div></div>' : '',
  ].join('') : '';

  const progressLabel = m.type==='streak'
    ? '<strong>'+m.current+'</strong> games active'
    : '<strong>'+(m.current||0).toLocaleString()+'</strong> / '+(m.target||0).toLocaleString()+' '+m.unit;

  return '<div class="mcard urgency-'+m.urgency+'" onclick="toggleCard(\''+m.id+'\')">'
    +'<div class="card-main">'
    +'<div class="card-top">'
    +'<div class="card-player-info"><div><span class="card-player">'+m.playerName+'</span><span class="card-num">'+(m.playerNum?' #'+m.playerNum:'')+' · '+(m.playerPos||'')+'</span></div><div class="card-stat">'+m.statType+'</div></div>'
    +'<div class="card-badges"><span class="badge '+(TB[m.type]||'badge-gray')+' badge-type">'+m.type+'</span>'
    +(m.urgency==='urgent'?'<span class="badge badge-red">~'+m.gamesAway+'G away</span>':'')
    +(m.pace===0?'<span class="badge badge-red">SEASON OVER</span>':'')
    +(m.type==='streak'&&m.isActive?'<span class="badge badge-green">ACTIVE '+m.current+'G</span>':'')
    +'</div></div>'
    +'<div class="progress-row"><div class="progress-track"><div class="progress-fill '+(PF[m.urgency]||'fill-blue')+'" style="width:'+pct+'%"></div></div>'
    +'<div class="progress-label">'+progressLabel+'</div></div>'
    +'<div class="card-snippet">'+(m.mediaAlert||'').substring(0,130)+((m.mediaAlert||'').length>130?'…':'')+'</div>'
    +(!isExpanded?'<div class="expand-hint">Click to expand media notes ↓</div>':'')
    +'</div>'
    +'<div class="card-expanded '+(isExpanded?'open':'')+'">'
    +'<div class="alert-block"><div class="alert-block-title">🎙 Media Alert</div><div class="alert-block-text">'+(m.mediaAlert||'')+'</div></div>'
    +'<div class="detail-grid">'
    +'<div class="detail-cell"><div class="detail-lbl">Progress</div><div class="detail-val">'+pct+'%</div></div>'
    +'<div class="detail-cell"><div class="detail-lbl">Games Away (est.)</div><div class="detail-val">'+gamesLabel+'</div></div>'
    +(m.pace!=null&&m.pace>0?'<div class="detail-cell"><div class="detail-lbl">Season Pace</div><div class="detail-val">'+m.pace+' / game</div></div>':'')
    +(m.gp_season!=null?'<div class="detail-cell"><div class="detail-lbl">Games Played</div><div class="detail-val">'+m.gp_season+'</div></div>':'')
    +streakExtras
    +'</div>'
    +'<div class="card-footer"><button class="test-alert-btn" data-test-id="'+m.id+'" onclick="event.stopPropagation();testSlackAlert(\''+m.id+'\')">↗ Test Slack Alert</button><span class="collapse-hint">Click card to collapse</span></div>'
    +'</div>'
    +'</div>';
}
