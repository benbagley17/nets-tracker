// ============================================================
// NETS MILESTONE TRACKER — APP LOGIC (hoopR-powered)
// Reads from /data/live_stats.json generated by fetch_nets_stats.R
// ============================================================

let state = {
  view:          'all',
  playerFilter:  'all',
  catFilter:     'all',
  expandedCards: new Set(),
  slackWebhook:  null,
  alertThreshold: 5,
  sentAlerts:    new Set(),
  lastUpdated:   null,
  dataMode:      'loading',
  allItems:      [],
  roster:        [],
};

// ── INIT ──────────────────────────────────────────────────────
window.addEventListener('DOMContentLoaded', () => {
  loadPersistedConfig();
  loadData();
});

// ── DATA LOADING ──────────────────────────────────────────────
async function loadData() {
  setDataMode('loading');
  try {
    const res = await fetch('data/live_stats.json?t=' + Date.now());
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const json = await res.json();
    ingestData(json);
  } catch (err) {
    console.warn('live_stats.json not available — using demo data:', err.message);
    ingestDemoData();
  }
}

function ingestData(json) {
  state.roster = json.roster || [];
  const milestones = json.milestones || [];
  const streaks    = json.streaks    || [];
  state.lastUpdated = json.meta?.generated_at ? new Date(json.meta.generated_at) : new Date();

  state.allItems = [...milestones, ...streaks].map(item => {
    const player = state.roster.find(r => r.id === item.player);
    return { ...item, playerName: player?.name || item.player, playerNum: player?.number, playerPos: player?.pos };
  });

  setDataMode('live');
  document.getElementById('apiBanner').classList.remove('show');
  buildSidebar();
  buildCatFilters();
  render();
  checkAndSendAlerts();
  updateLastUpdated(json.meta);
}

function ingestDemoData() {
  state.roster = [
    { id:'claxton',  name:'Nic Claxton',        number:'33', pos:'C'  },
    { id:'porter',   name:'Michael Porter Jr.', number:'1',  pos:'SF' },
    { id:'demin',    name:'Egor Dëmin',          number:'8',  pos:'PG' },
    { id:'williams', name:'Ziaire Williams',     number:'1',  pos:'SF' },
    { id:'mann',     name:'Terance Mann',        number:'14', pos:'SG' },
    { id:'wilson',   name:'Jalen Wilson',        number:'22', pos:'SF' },
    { id:'sharpe',   name:"Day'Ron Sharpe",      number:'20', pos:'C'  },
  ];
  const milestones = [
    { id:'claxton-500-blocks', player:'claxton', type:'milestone', category:'Blocks', statType:'Career Blocks', current:487, target:500, unit:'BLK', pace:1.1, gamesAway:12, urgency:'close', mediaAlert:"Prepare a '500-block club' historical comparison. Claxton is one of the youngest Nets to reach this mark." },
    { id:'claxton-franchise-blk-record', player:'claxton', type:'record', category:'Blocks', statType:'Franchise All-Time Blocks Record', current:487, target:522, unit:'BLK', pace:1.1, gamesAway:32, urgency:'upcoming', mediaAlert:'FRANCHISE ALL-TIME RECORD. Coordinate with Nets PR. Reach out to Brook Lopez for a potential tribute.' },
    { id:'porter-1000-career-3pm', player:'porter', type:'milestone', category:'Three-Pointers', statType:'Career 3-Pointers Made', current:919, target:1000, unit:'3PM', pace:0, gamesAway:null, urgency:'upcoming', mediaAlert:'Only ~200 NBA players have made 1,000 career threes. Porter averaged 3.4 per game before his hamstring ended his year. Pre-write for 2026-27.' },
    { id:'williams-300-career-3pm', player:'williams', type:'milestone', category:'Three-Pointers', statType:'Career 3-Pointers Made', current:287, target:300, unit:'3PM', pace:1.8, gamesAway:7, urgency:'close', mediaAlert:'Quiet redemption narrative — drafted 10th overall, now a reliable floor spacer. 300 career threes marks his establishment.' },
    { id:'mann-500-career-games', player:'mann', type:'milestone', category:'Games', statType:'Career Games Played', current:471, target:500, unit:'GP', pace:1.0, gamesAway:29, urgency:'upcoming', mediaAlert:'500 NBA games is a longevity milestone. Mann went from a 2019 Clippers role player to a key two-way veteran.' },
    { id:'wilson-1000-career-pts', player:'wilson', type:'milestone', category:'Points', statType:'Career Points', current:863, target:1000, unit:'PTS', pace:7.2, gamesAway:19, urgency:'upcoming', mediaAlert:'Wilson appeared in a league-high 79 games. His 1,000th career point marks establishment in the league.' },
  ];
  const streaks = [
